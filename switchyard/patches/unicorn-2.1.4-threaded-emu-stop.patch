diff --git a/tests/regress/threaded_emu_stop.c b/tests/regress/threaded_emu_stop.c
new file mode 100644
index 0000000..e4cc03f
--- /dev/null
+++ b/tests/regress/threaded_emu_stop.c
@@ -0,0 +1,145 @@
+/* Test cross-thread uc_emu_stop() without racing the emulation thread state. */
+
+#define _POSIX_C_SOURCE 200809L
+
+#include <pthread.h>
+#include <sched.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <unicorn/unicorn.h>
+
+#define ADDRESS 0x100000
+#define ITERATIONS 100
+#define TIMEOUT_SECONDS 5
+
+struct test_state
+{
+    uc_engine *uc;
+    atomic_uint entered;
+    atomic_uint released;
+    atomic_uint finished;
+    uc_err result;
+};
+
+static bool wait_for_value(atomic_uint *value, unsigned int expected)
+{
+    struct timespec start, now;
+
+    clock_gettime(CLOCK_MONOTONIC, &start);
+    do
+    {
+        /* Keep this coordination relaxed: an acquire/release pair would hide
+         * unrelated engine-state races from ThreadSanitizer. */
+        if (atomic_load_explicit(value, memory_order_relaxed) >= expected)
+            return true;
+        sched_yield();
+        clock_gettime(CLOCK_MONOTONIC, &now);
+    } while (now.tv_sec - start.tv_sec < TIMEOUT_SECONDS);
+    return false;
+}
+
+static void code_hook(uc_engine *uc, uint64_t address, uint32_t size,
+                      void *user_data)
+{
+    struct test_state *state = user_data;
+    unsigned int generation;
+
+    (void)uc;
+    (void)address;
+    (void)size;
+
+    generation = atomic_fetch_add_explicit(&state->entered, 1,
+                                           memory_order_relaxed) + 1;
+    while (atomic_load_explicit(&state->released, memory_order_relaxed) <
+           generation)
+        sched_yield();
+}
+
+static void *emulation_thread(void *arg)
+{
+    struct test_state *state = arg;
+
+    state->result = uc_emu_start(state->uc, ADDRESS, UINT64_MAX, 0, 0);
+    atomic_fetch_add_explicit(&state->finished, 1, memory_order_relaxed);
+    return NULL;
+}
+
+int main(void)
+{
+    static const unsigned char code[] = {0xeb, 0xfe}; /* jmp $ */
+    struct test_state state = {0};
+    pthread_t thread;
+    uc_hook hook;
+    uc_err err;
+    unsigned int i;
+    int ret;
+
+    alarm(TIMEOUT_SECONDS * 3);
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_32, &state.uc)))
+    {
+        fprintf(stderr, "open failed: %s\n", uc_strerror(err));
+        return 1;
+    }
+
+    /* Stopping must not initialize an otherwise idle engine. */
+    if ((err = uc_emu_stop(state.uc)) ||
+        (err = uc_mem_map(state.uc, ADDRESS, 0x1000, UC_PROT_ALL)) ||
+        (err = uc_mem_write(state.uc, ADDRESS, code, sizeof(code))) ||
+        (err = uc_hook_add(state.uc, &hook, UC_HOOK_CODE, code_hook, &state,
+                           ADDRESS, ADDRESS + sizeof(code) - 1)))
+    {
+        fprintf(stderr, "setup failed: %s\n", uc_strerror(err));
+        return 1;
+    }
+
+    /* A stop made after initialization must not prevent the next start. */
+    if ((err = uc_emu_stop(state.uc)))
+    {
+        fprintf(stderr, "idle stop failed: %s\n", uc_strerror(err));
+        return 1;
+    }
+
+    for (i = 1; i <= ITERATIONS; i++)
+    {
+        if ((ret = pthread_create(&thread, NULL, emulation_thread, &state)))
+        {
+            fprintf(stderr, "pthread_create failed: %d\n", ret);
+            return 1;
+        }
+        if (!wait_for_value(&state.entered, i))
+        {
+            fputs("emulation did not enter\n", stderr);
+            return 1;
+        }
+
+        /* The emulation owner is inside the hook while this runs. */
+        if ((err = uc_emu_stop(state.uc)))
+        {
+            fprintf(stderr, "cross-thread stop failed: %s\n", uc_strerror(err));
+            return 1;
+        }
+
+        atomic_store_explicit(&state.released, i, memory_order_relaxed);
+        if (!wait_for_value(&state.finished, i))
+        {
+            fputs("emulation did not stop\n", stderr);
+            return 1;
+        }
+        pthread_join(thread, NULL);
+        if (state.result != UC_ERR_OK)
+        {
+            fprintf(stderr, "emulation failed: %s\n", uc_strerror(state.result));
+            return 1;
+        }
+    }
+
+    uc_close(state.uc);
+    alarm(0);
+    puts("cross-thread stop passed");
+    return 0;
+}
