+        engine->uc_invalidate_tb_host(engine, other_host, size);
+    }
+    shared_atomic_registry_release();
+}
+
+void uc_shared_code_write_end(uc_engine *uc)
+{
+    if (!uc->shared_code_write_active) return;
+    uc->shared_code_write_active = false;
+    uc_shared_atomic_end_exclusive(uc);
+}
