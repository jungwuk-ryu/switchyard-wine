+static uc_engine *shared_atomic_engines;
+static uc_engine *shared_atomic_owner;
+static int shared_atomic_registry_lock;
+
+static void shared_atomic_registry_acquire(void)
+{
+    while (atomic_cmpxchg(&shared_atomic_registry_lock, 0, 1)) cpu_relax();
