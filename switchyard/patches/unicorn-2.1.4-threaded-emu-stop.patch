+{
+#if defined(__APPLE__) && defined(__aarch64__) &&                         \
+    defined(HAVE_PTHREAD_JIT_PROTECT)
+    struct mock_engine engine;
+    struct mock_engine *uc = &engine;
+    bool entry, actual;
+    int value = 0;
+
+    if (!pthread_jit_write_protect_supported_np())
+    {
+        puts("Apple JIT state unavailable; skipped");
+        return 0;
+    }
+
+    entry = thread_executable();
+
+    jit_write_protect(false);
+    uc->current_executable = true;
+    JIT_CALLBACK_GUARD((void)0);
+    actual = thread_executable();
+    if (actual || uc->current_executable)
+    {
+        fprintf(stderr,
+                "guard trusted stale executable cache: actual=%d cached=%d\n",
+                actual, uc->current_executable);
+        jit_write_protect(entry);
+        return 1;
+    }
+
+    jit_write_protect(true);
+    uc->current_executable = false;
+    JIT_CALLBACK_GUARD_VAR(value,
+                           (jit_write_protect(false), 42));
+    actual = thread_executable();
+    if (!actual || !uc->current_executable || value != 42)
+    {
+        fprintf(stderr,
+                "value guard trusted stale writable cache: actual=%d "
+                "cached=%d value=%d\n",
+                actual, uc->current_executable, value);
+        jit_write_protect(entry);
+        return 1;
+    }
+
+    jit_write_protect(entry);
+    puts("Apple JIT state guards preserved the caller mode");
+    return 0;
+#else
+    puts("Apple JIT state unavailable; skipped");
+    return 0;
+#endif
+}
diff --git a/tests/regress/atomic_unmapped_hook.c b/tests/regress/atomic_unmapped_hook.c
new file mode 100644
index 0000000000000000000000000000000000000000..50043d4ecdb6a65be48d95f56e20f517b8f07cfe
--- /dev/null
+++ b/tests/regress/atomic_unmapped_hook.c
@@ -0,0 +1,142 @@
+/* Test invalid-memory recovery for an atomic read-modify-write operation. */
+
+#define _POSIX_C_SOURCE 200809L
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <unicorn/unicorn.h>
+#include <unicorn/x86.h>
+
+#define CODE_ADDRESS UINT64_C(0x100000)
+#define DATA_ADDRESS UINT64_C(0x200000)
+#define TARGET_ADDRESS (DATA_ADDRESS + 1)
+#define PAGE_SIZE 0x1000
+#define TIMEOUT_SECONDS 5
+
+struct hook_state
+{
+    uint64_t *data;
+    unsigned int calls;
+    uc_err map_error;
+};
+
+static const unsigned char code[] =
+{
+    0x48, 0xb8, 0x01, 0x00, 0x20, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0xf0, 0x48, 0xff, 0x00, /* lock incq (TARGET_ADDRESS) */
+};
+
+static bool map_atomic_target(uc_engine *uc, uc_mem_type type,
+                              uint64_t address, int size, int64_t value,
+                              void *user_data)
+{
+    struct hook_state *state = user_data;
+
+    (void)value;
+    ++state->calls;
+    if (type != UC_MEM_WRITE_UNMAPPED || address != TARGET_ADDRESS || size != 8) {
+        return false;
+    }
+    state->map_error = uc_mem_map_ptr(uc, DATA_ADDRESS, PAGE_SIZE,
+                                      UC_PROT_READ | UC_PROT_WRITE,
+                                      state->data);
+    return state->map_error == UC_ERR_OK;
+}
+
+static uc_err open_test_engine(uc_engine **uc)
+{
+    uc_err err;
+
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_64, uc)) ||
+        (err = uc_enable_shared_memory_atomics(*uc)) ||
+        (err = uc_mem_map(*uc, CODE_ADDRESS, PAGE_SIZE, UC_PROT_ALL)) ||
+        (err = uc_mem_write(*uc, CODE_ADDRESS, code, sizeof(code)))) {
+        if (*uc) {
+            uc_close(*uc);
+            *uc = NULL;
+        }
+    }
+    return err;
+}
+
+static int test_recover_unmapped_atomic(uint64_t *data)
+{
+    struct hook_state state = {.data = data};
+    uc_engine *uc = NULL;
+    uc_hook hook;
+    uc_err err;
+    int ret = 1;
+
+    uint64_t value = 0;
+
+    memcpy((unsigned char *)data + 1, &value, sizeof(value));
+    if ((err = open_test_engine(&uc)) ||
+        (err = uc_hook_add(uc, &hook, UC_HOOK_MEM_WRITE_UNMAPPED,
+                           map_atomic_target, &state, TARGET_ADDRESS,
+                           TARGET_ADDRESS + sizeof(*data) - 1)) ||
+        (err = uc_emu_start(uc, CODE_ADDRESS, CODE_ADDRESS + sizeof(code),
+                            0, 0))) {
+        fprintf(stderr, "recovering atomic access failed: %s\n",
+                uc_strerror(err));
+        goto done;
+    }
+    memcpy(&value, (unsigned char *)data + 1, sizeof(value));
+    if (value != 1 || state.calls != 1 || state.map_error != UC_ERR_OK) {
+        fprintf(stderr, "atomic recovery mismatch: value %llu, calls %u, "
+                "map error %s\n", (unsigned long long)value, state.calls,
+                uc_strerror(state.map_error));
+        goto done;
+    }
+    ret = 0;
+
+ done:
+    if (uc) uc_close(uc);
+    return ret;
+}
+
+static int test_reject_unhandled_atomic(void)
+{
+    uc_engine *uc = NULL;
+    uc_err err;
+
+    if ((err = open_test_engine(&uc))) {
+        fprintf(stderr, "unhandled atomic setup failed: %s\n",
+                uc_strerror(err));
+        return 1;
+    }
+    err = uc_emu_start(uc, CODE_ADDRESS, CODE_ADDRESS + sizeof(code), 0, 0);
+    uc_close(uc);
+    if (err != UC_ERR_WRITE_UNMAPPED) {
+        fprintf(stderr, "unhandled atomic returned %s\n", uc_strerror(err));
+        return 1;
+    }
+    return 0;
+}
+
+int main(void)
+{
+    uint64_t *data = NULL;
+    int ret = 1;
+
+    alarm(TIMEOUT_SECONDS);
+    if (posix_memalign((void **)&data, PAGE_SIZE, PAGE_SIZE)) {
+        fprintf(stderr, "data allocation failed\n");
+        return 2;
+    }
+    memset(data, 0, PAGE_SIZE);
+    if (test_recover_unmapped_atomic(data) || test_reject_unhandled_atomic()) {
+        goto done;
+    }
+    puts("atomic invalid-memory hook recovery passed");
+    ret = 0;
+
+ done:
+    free(data);
+    alarm(0);
+    return ret;
+}
diff --git a/tests/regress/shared_code_coherence.c b/tests/regress/shared_code_coherence.c
new file mode 100644
index 0000000000000000000000000000000000000000..4b366e321667ae08a1b705d630d8753e5d4fe469
--- /dev/null
+++ b/tests/regress/shared_code_coherence.c
@@ -0,0 +1,155 @@
+/* Verify that independent engines sharing executable host backing observe
+ * guest writes after the writer has completed. */
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <unicorn/unicorn.h>
+#include <unicorn/x86.h>
+
+#ifndef UC_SWITCHYARD_SHARED_MEMORY_ATOMICS
+#error UC_SWITCHYARD_SHARED_MEMORY_ATOMICS is required
+#endif
+
+#define CODE_ADDRESS   0x10000u
+#define STOP_ADDRESS   (CODE_ADDRESS + 0x100u)
+#define WRITER_ADDRESS 0x20000u
+#define PAGE_SIZE      0x1000u
+
+static int fail(uc_err err, const char *operation)
+{
+    fprintf(stderr, "%s failed: %s\n", operation, uc_strerror(err));
+    return 1;
+}
+
+static void stop_block(uc_engine *uc, uint64_t address, uint32_t size,
+                       void *opaque)
+{
+    (void)address;
+    (void)size;
+    (void)opaque;
+    uc_emu_stop(uc);
+}
+
+static int read_eax(uc_engine *uc, uint32_t *eax)
+{
+    uc_err err;
+
+    *eax = 0;
+    if ((err = uc_reg_write(uc, UC_X86_REG_EAX, eax)))
+        return fail(err, "clear eax");
+    if ((err = uc_emu_start(uc, CODE_ADDRESS, UINT64_MAX, 0, 0)))
+        return fail(err, "execute shared code");
+    if ((err = uc_reg_read(uc, UC_X86_REG_EAX, eax)))
+        return fail(err, "read eax");
+    return 0;
+}
+
+int main(void)
+{
+    static const uint8_t initial_code[] =
+    {
+        0xb8, 0x01, 0x00, 0x00, 0x00, /* mov $1,%eax */
+        0xe9, 0xf6, 0x00, 0x00, 0x00, /* jmp STOP_ADDRESS */
+    };
+    static const uint8_t writer_code[] =
+    {
+        0xfe, 0x04, 0x25, 0x01, 0x00, 0x01, 0x00,
+        /* incb CODE_ADDRESS+1 */
+    };
+    uc_engine *reader = NULL, *writer = NULL;
+    uc_hook stop_hook;
+    uint8_t *shared = NULL;
+    uint32_t eax;
+    uc_err err;
+    int ret = 1;
+
+    if (posix_memalign((void **)&shared, PAGE_SIZE, PAGE_SIZE))
+    {
+        fputs("cannot allocate shared page\n", stderr);
+        return 1;
+    }
+    memset(shared, 0, PAGE_SIZE);
+    memcpy(shared, initial_code, sizeof(initial_code));
+
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_64, &reader)) ||
+        (err = uc_open(UC_ARCH_X86, UC_MODE_64, &writer)) ||
+        (err = uc_enable_shared_memory_atomics(reader)) ||
+        (err = uc_enable_shared_memory_atomics(writer)) ||
+        (err = uc_mem_map_ptr(reader, CODE_ADDRESS, PAGE_SIZE,
+                              UC_PROT_ALL, shared)) ||
+        (err = uc_mem_map_ptr(writer, CODE_ADDRESS, PAGE_SIZE,
+                              UC_PROT_ALL, shared)) ||
+        (err = uc_hook_add(reader, &stop_hook, UC_HOOK_BLOCK, stop_block,
+                           NULL, STOP_ADDRESS, STOP_ADDRESS)) ||
+        (err = uc_mem_map(writer, WRITER_ADDRESS, PAGE_SIZE,
+                          UC_PROT_ALL)) ||
+        (err = uc_mem_write(writer, WRITER_ADDRESS, writer_code,
+                            sizeof(writer_code))))
+    {
+        fail(err, "setup");
+        goto done;
+    }
+
+    if (read_eax(reader, &eax)) goto done;
+    if (eax != 1)
+    {
+        fprintf(stderr, "initial translated result is %u, expected 1\n", eax);
+        goto done;
+    }
+
+    if ((err = uc_emu_start(writer, WRITER_ADDRESS,
+                            WRITER_ADDRESS + sizeof(writer_code), 0, 0)))
+    {
+        fail(err, "execute guest writer");
+        goto done;
+    }
+    if (shared[1] != 2)
+    {
+        fprintf(stderr, "guest writer stored %#x, expected 2\n", shared[1]);
+        goto done;
+    }
+
+    if (read_eax(reader, &eax)) goto done;
+    if (eax != 2)
+    {
+        fprintf(stderr, "stale translated result is %u, expected 2\n", eax);
+        goto done;
+    }
+
+    /* The first write made the writer's target-page TLB entry dirty.  The
+     * reader then translated the modified page.  A second writer store must
+     * still take the coherence path; otherwise its dirty TLB fast path leaves
+     * the reader's newly cached TB stale. */
+    if ((err = uc_emu_start(writer, WRITER_ADDRESS,
+                            WRITER_ADDRESS + sizeof(writer_code), 0, 0)))
+    {
+        fail(err, "execute repeated guest writer");
+        goto done;
+    }
+    if (shared[1] != 3)
+    {
+        fprintf(stderr, "repeated guest writer stored %#x, expected 3\n",
+                shared[1]);
+        goto done;
+    }
+
+    if (read_eax(reader, &eax)) goto done;
+    if (eax != 3)
+    {
+        fprintf(stderr, "stale post-dirty translated result is %u, expected 3\n",
+                eax);
+        goto done;
+    }
+
+    puts("shared executable backing stayed coherent");
+    ret = 0;
+
+done:
+    if (writer) uc_close(writer);
+    if (reader) uc_close(reader);
+    free(shared);
+    return ret;
+}
diff --git a/tests/regress/shared_code_jit_state.c b/tests/regress/shared_code_jit_state.c
new file mode 100644
index 0000000000000000000000000000000000000000..382e36ccb5a389072cf550480116466967a8ed3b
--- /dev/null
+++ b/tests/regress/shared_code_jit_state.c
@@ -0,0 +1,122 @@
+/* Verify foreign-engine TB invalidation preserves the calling thread's
+ * Apple MAP_JIT mode while resetting a direct jump in the target engine. */
+
+#define _POSIX_C_SOURCE 200809L
+
+#include <pthread.h>
+#include <signal.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include <unicorn/unicorn.h>
+
+#define CODE_ADDRESS   0x10000u
+#define WRITER_ADDRESS 0x20000u
+#define PAGE_SIZE      0x1000u
+#define WRITES         10000u
+
+struct reader_state
+{
+    uc_engine *uc;
+    atomic_bool started;
+    uc_err result;
+};
+
+static void *run_reader(void *opaque)
+{
+    struct reader_state *state = opaque;
+
+    atomic_store_explicit(&state->started, true, memory_order_release);
+    state->result = uc_emu_start(state->uc, CODE_ADDRESS, UINT64_MAX, 0, 0);
+    return NULL;
+}
+
+int main(void)
+{
+    static const uint8_t writer_code[] =
+    {
+        0xfe, 0x04, 0x25, 0x01, 0x00, 0x01, 0x00, /* incb 0x10001 */
+    };
+    struct reader_state reader = {0};
+    struct timespec delay = {0, 10000000};
+    uc_engine *writer = NULL;
+    uint8_t *shared = NULL;
+    pthread_t thread;
+    uc_err err = UC_ERR_OK;
+    unsigned int i;
+    int ret = 1;
+
+    alarm(30);
+    if (posix_memalign((void **)&shared, PAGE_SIZE, PAGE_SIZE))
+    {
+        fputs("shared allocation failed\n", stderr);
+        return 2;
+    }
+    memset(shared, 0x90, PAGE_SIZE);
+    shared[0x00] = 0xb8; /* mov imm32,%eax */
+    shared[0x01] = 1;
+    shared[0x05] = 0xeb; /* jmp 0x10020 */
+    shared[0x06] = 0x19;
+    shared[0x20] = 0xeb; /* jmp 0x10000 */
+    shared[0x21] = 0xde;
+
+    if ((err = uc_open(UC_ARCH_X86, UC_MODE_64, &reader.uc)) ||
+        (err = uc_open(UC_ARCH_X86, UC_MODE_64, &writer)) ||
+        (err = uc_enable_shared_memory_atomics(reader.uc)) ||
+        (err = uc_enable_shared_memory_atomics(writer)) ||
+        (err = uc_mem_map_ptr(reader.uc, CODE_ADDRESS, PAGE_SIZE,
+                              UC_PROT_ALL, shared)) ||
+        (err = uc_mem_map_ptr(writer, CODE_ADDRESS, PAGE_SIZE,
+                              UC_PROT_ALL, shared)) ||
+        (err = uc_mem_map(writer, WRITER_ADDRESS, PAGE_SIZE, UC_PROT_ALL)) ||
+        (err = uc_mem_write(writer, WRITER_ADDRESS, writer_code,
+                            sizeof(writer_code))) ||
+        (err = uc_emu_start(reader.uc, CODE_ADDRESS, UINT64_MAX, 0, 100)))
+    {
+        fprintf(stderr, "setup failed: %s\n", uc_strerror(err));
+        goto done;
+    }
+
+    if (pthread_create(&thread, NULL, run_reader, &reader))
+    {
+        fputs("reader thread creation failed\n", stderr);
+        goto done;
+    }
+    while (!atomic_load_explicit(&reader.started, memory_order_acquire)) {}
+    nanosleep(&delay, NULL);
+
+    for (i = 0; i < WRITES; ++i)
+    {
+        err = uc_emu_start(writer, WRITER_ADDRESS,
+                           WRITER_ADDRESS + sizeof(writer_code), 0, 0);
+        if (err != UC_ERR_OK)
+        {
+            fprintf(stderr, "writer failed at %u: %d (%s)\n", i, (int)err,
+                    uc_strerror(err));
+            break;
+        }
+    }
+
+    uc_emu_stop(reader.uc);
+    pthread_join(thread, NULL);
+    if (err != UC_ERR_OK || reader.result != UC_ERR_OK)
+    {
+        fprintf(stderr, "reader result: %d (%s)\n", (int)reader.result,
+                uc_strerror(reader.result));
+        goto done;
+    }
+
+    printf("shared-code JIT state passed %u writes\n", i);
+    ret = 0;
+
+done:
+    if (writer) uc_close(writer);
+    if (reader.uc) uc_close(reader.uc);
+    free(shared);
+    alarm(0);
+    return ret;
+}
diff --git a/tests/regress/shared_code_start_race.c b/tests/regress/shared_code_start_race.c
