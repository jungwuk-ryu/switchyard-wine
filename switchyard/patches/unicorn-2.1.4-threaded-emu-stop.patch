+    if (!atomic_read(&uc->shared_memory_atomics) || !host_address || !size)
+        return;
+    if (!uc->shared_code_write_active) {
+        if (!uc_shared_atomic_begin_exclusive(uc)) return;
+        uc->shared_code_write_active = true;
+    }
+
+    shared_atomic_registry_acquire();
+    for (engine = shared_atomic_engines; engine;
+         engine = engine->shared_atomic_next) {
+        void *other_host = NULL;
