 /* Probe for a read-modify-write atomic operation.  Do not allow unaligned
  * operations, or io operations to proceed.  Return the host address.  */
+static bool atomic_mmu_invalid_hook(CPUArchState *env, uc_hook_idx hook_idx,
+                                    uc_mem_type type, hwaddr paddr, size_t size,
+                                    uintptr_t retaddr, bool *synced)
+{
+    struct uc_struct *uc = env->uc;
+    struct list_item *cur;
+    struct hook *hook;
+    bool handled;
+
+    if (uc->invalid_error != UC_ERR_OK) {
+        return false;
+    }
+
+    for (cur = uc->hook[hook_idx].head;
+         cur != NULL && (hook = (struct hook *)cur->data); cur = cur->next) {
+        if (hook->to_delete || !HOOK_BOUND_CHECK(hook, paddr)) {
+            continue;
+        }
+        if (!*synced && !uc->skip_sync_pc_on_exit && retaddr) {
+            cpu_restore_state(uc->cpu, retaddr, false);
+            *synced = true;
+        }
+        JIT_CALLBACK_GUARD_VAR(
+            handled, ((uc_cb_eventmem_t)hook->callback)(
+                         uc, type, paddr, size, 0, hook->user_data));
+        if (handled) {
+            uc->invalid_error = UC_ERR_OK;
+            return true;
+        }
+        if (uc_stop_requested(uc)) {
+            break;
+        }
+    }
+    return false;
+}
