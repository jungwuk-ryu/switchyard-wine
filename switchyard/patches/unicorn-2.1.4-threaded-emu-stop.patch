+
+static void shared_atomic_registry_release(void)
+{
+    atomic_xchg(&shared_atomic_registry_lock, 0);
+}
+
+static void register_shared_atomic_engine(uc_engine *uc)
+{
+    shared_atomic_registry_acquire();
+    if (!atomic_read(&uc->shared_memory_atomics)) {
+        uc->shared_atomic_next = shared_atomic_engines;
+        shared_atomic_engines = uc;
+        atomic_xchg(&uc->shared_memory_atomics, true);
+    }
+    shared_atomic_registry_release();
+}
+
+static void unregister_shared_atomic_engine(uc_engine *uc)
+{
+    uc_engine **link;
+
+    if (!atomic_read(&uc->shared_memory_atomics)) return;
+    shared_atomic_registry_acquire();
+    for (link = &shared_atomic_engines; *link; link = &(*link)->shared_atomic_next) {
+        if (*link != uc) continue;
+        *link = uc->shared_atomic_next;
+        uc->shared_atomic_next = NULL;
+        atomic_xchg(&uc->shared_memory_atomics, false);
+        break;
+    }
+    shared_atomic_registry_release();
+}
+
+bool uc_shared_atomic_enter(uc_engine *uc)
+{
+    uc_engine *owner;
+
+    if (!atomic_read(&uc->shared_memory_atomics)) return true;
+    for (;;) {
+        while ((owner = atomic_read(&shared_atomic_owner)) && owner != uc) {
+            if (uc_stop_requested(uc)) return false;
+            cpu_relax();
+        }
+        uc_set_shared_pause_request(uc, false);
+        atomic_xchg(&uc->shared_atomic_running, true);
+        owner = atomic_read(&shared_atomic_owner);
+        if (!owner || owner == uc) return true;
+        atomic_xchg(&uc->shared_atomic_running, false);
+    }
+}
+
+void uc_shared_atomic_leave(uc_engine *uc)
+{
+    if (atomic_read(&uc->shared_memory_atomics))
+        atomic_xchg(&uc->shared_atomic_running, false);
+}
+
+bool uc_shared_atomic_begin_exclusive(uc_engine *uc)
+{
+    uc_engine *engine, *owner;
+    bool pending;
+
+    if (atomic_read(&shared_atomic_owner) == uc) {
+        g_assert(uc->shared_exclusive_depth);
+        ++uc->shared_exclusive_depth;
+        return true;
+    }
+
+    for (;;) {
+        owner = atomic_cmpxchg(&shared_atomic_owner, NULL, uc);
+        if (!owner) break;
+        if (atomic_read(&uc->shared_memory_atomics))
+            atomic_xchg(&uc->shared_atomic_running, false);
+        while (atomic_read(&shared_atomic_owner)) {
+            if (uc_stop_requested(uc)) {
+                if (atomic_read(&uc->shared_memory_atomics))
+                    atomic_xchg(&uc->shared_atomic_running, true);
+                return false;
+            }
+            cpu_relax();
+        }
+        if (atomic_read(&uc->shared_memory_atomics))
+            atomic_xchg(&uc->shared_atomic_running, true);
+    }
+
+    shared_atomic_registry_acquire();
+    for (engine = shared_atomic_engines; engine;
+         engine = engine->shared_atomic_next) {
+        if (engine != uc && atomic_read(&engine->shared_atomic_running)) {
+            uc_set_shared_pause_request(engine, true);
+            cpu_exit(engine->cpu);
+        }
+    }
+    do {
+        pending = false;
+        for (engine = shared_atomic_engines; engine;
+             engine = engine->shared_atomic_next) {
+            if (engine != uc && atomic_read(&engine->shared_atomic_running)) {
+                pending = true;
+                cpu_relax();
+                break;
+            }
+        }
+    } while (pending);
+    shared_atomic_registry_release();
+    uc->shared_exclusive_depth = 1;
+    return true;
+}
+
+void uc_shared_atomic_end_exclusive(uc_engine *uc)
+{
+    g_assert(atomic_read(&shared_atomic_owner) == uc);
+    g_assert(uc->shared_exclusive_depth);
+    if (--uc->shared_exclusive_depth) return;
+    g_assert(atomic_cmpxchg(&shared_atomic_owner, uc, NULL) == uc);
+}
+
+void uc_shared_atomic_abort_exclusive(uc_engine *uc)
+{
+    uc->shared_code_write_active = false;
+    uc->shared_code_translation_active = false;
+    uc->shared_exclusive_depth = 0;
+    atomic_cmpxchg(&shared_atomic_owner, uc, NULL);
+}
+
+static bool shared_executable_mapping(uc_engine *uc, uint64_t address,
+                                      size_t size, bool require_write,
+                                      void **host_address)
+{
+    MemoryRegion *mr;
+    uint64_t offset, region_size;
+
+    if (!size || !(mr = uc->memory_mapping(uc, address)) || !mr->ram ||
+        !(mr->perms & UC_PROT_EXEC) ||
+        (require_write && !(mr->perms & UC_PROT_WRITE)) ||
+        address < mr->addr)
+        return false;
+    offset = address - mr->addr;
+    region_size = int128_get64(mr->size);
+    if (offset > region_size || size > region_size - offset) return false;
+    if (host_address)
+        *host_address = mr->ram_block->host + offset;
+    return true;
+}
+
+bool uc_shared_code_translation_begin(uc_engine *uc, uint64_t address,
+                                      size_t size)
+{
+    bool writable;
+
+    writable = shared_executable_mapping(uc, address, 1, true, NULL);
+    if (!writable && size && address <= UINT64_MAX - (size - 1))
+        writable = shared_executable_mapping(uc, address + size - 1, 1,
+                                             true, NULL);
+    if (!atomic_read(&uc->shared_memory_atomics) ||
+        !writable)
+        return false;
+    g_assert(!uc->shared_code_translation_active);
+    if (!uc_shared_atomic_begin_exclusive(uc)) return false;
+    uc->shared_code_translation_active = true;
+    return true;
+}
+
+void uc_shared_code_translation_end(uc_engine *uc)
+{
+    if (!uc->shared_code_translation_active) return;
+    uc->shared_code_translation_active = false;
+    uc_shared_atomic_end_exclusive(uc);
+}
+
+void uc_shared_code_write_begin(uc_engine *uc, uint64_t address, size_t size,
+                                void *host_address)
+{
+    uc_engine *engine;
