From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jungwuk-ryu <vojougae35@gmail.com>
Date: Mon, 24 Aug 2026 07:49:37 +0900
Subject: [PATCH] fix(dxmt): use owned buffer backing for i386

---
 src/d3d11/d3d11_buffer.cpp            |  3 ---
 src/d3d11/d3d11_texture_dynamic.cpp   |  5 +----
 src/dxmt/dxmt_buffer.cpp              | 12 ++----------
 src/dxmt/dxmt_buffer.hpp              |  5 +----
 src/dxmt/dxmt_context.cpp             | 11 +++++++++--
 src/dxmt/dxmt_occlusion_query.hpp     |  8 +-------
 src/dxmt/dxmt_ring_bump_allocator.hpp | 12 +++++++++++-
 src/dxmt/dxmt_staging.cpp             |  3 ---
 src/dxmt/dxmt_texture.cpp             |  9 +--------
 src/dxmt/dxmt_texture.hpp             |  3 ++-
 10 files changed, 28 insertions(+), 43 deletions(-)

diff --git a/src/d3d11/d3d11_buffer.cpp b/src/d3d11/d3d11_buffer.cpp
index c354db3..0454a9f 100644
--- a/src/d3d11/d3d11_buffer.cpp
+++ b/src/d3d11/d3d11_buffer.cpp
@@ -98,9 +98,6 @@ public:
         flags.set(BufferAllocationFlag::GpuManaged);
     } else {
       flags.set(BufferAllocationFlag::SuballocateFromOnePage);
-#ifdef __i386__
-      flags.set(BufferAllocationFlag::CpuPlaced);
-#endif
     }
     auto allocation = buffer_->allocate(flags);
     auto &initializer = device->GetDXMTDevice().queue().initializer;
diff --git a/src/d3d11/d3d11_texture_dynamic.cpp b/src/d3d11/d3d11_texture_dynamic.cpp
index da9a7cc..c1d5f0e 100644
--- a/src/d3d11/d3d11_texture_dynamic.cpp
+++ b/src/d3d11/d3d11_texture_dynamic.cpp
@@ -118,9 +118,6 @@ HRESULT CreateDynamicTextureInternal(MTLD3D11Device *pDevice,
     }
     Flags<BufferAllocationFlag> buffer_flags;
     buffer_flags.set(BufferAllocationFlag::CpuWriteCombined, BufferAllocationFlag::SuballocateFromOnePage);
-#ifdef __i386__
-    buffer_flags.set(BufferAllocationFlag::CpuPlaced);
-#endif
     Subresource subresource;
     subresource.buffer = new Buffer(buf_len, pDevice->GetMTLDevice());
     subresource.buffer->rename(subresource.buffer->allocate(buffer_flags));
@@ -183,4 +180,4 @@ CreateDynamicTexture3D(MTLD3D11Device *pDevice,
 
 #pragma endregion
 
-} // namespace dxmt
\ No newline at end of file
+} // namespace dxmt
diff --git a/src/dxmt/dxmt_buffer.cpp b/src/dxmt/dxmt_buffer.cpp
index e918e63..8ec88b7 100644
--- a/src/dxmt/dxmt_buffer.cpp
+++ b/src/dxmt/dxmt_buffer.cpp
@@ -21,7 +21,6 @@
 #include "thread.hpp"
 #include "util_likely.hpp"
 #include "util_math.hpp"
-#include "wsi_platform.hpp"
 #include <cassert>
 #include <mutex>
 
@@ -41,21 +40,14 @@ BufferAllocation::BufferAllocation(WMT::Device device, const WMTBufferInfo &info
     info_.length = DXMT_PAGE_SIZE;
   }
   fenceTrackers.resize(suballocation_count_);
-  if (flags_.test(BufferAllocationFlag::CpuPlaced)) {
-    placed_buffer = wsi::aligned_malloc(info_.length, DXMT_PAGE_SIZE);
-    info_.memory.set(placed_buffer);
-  }
   obj_ = device.newBuffer(info_);
   gpuAddress_ = info_.gpu_address;
+  // Storage returned in info_.memory is borrowed from obj_.
   mappedMemory_ = info_.memory.get_accessible_or_null();
 };
 
 void
 BufferAllocation::free() {
-  if (placed_buffer) {
-    wsi::aligned_free(placed_buffer);
-    placed_buffer = nullptr;
-  }
   delete this;
 }
 
@@ -185,4 +177,4 @@ Buffer::decRef() {
     delete this;
 };
 
-} // namespace dxmt
\ No newline at end of file
+} // namespace dxmt
diff --git a/src/dxmt/dxmt_buffer.hpp b/src/dxmt/dxmt_buffer.hpp
index 9feb708..4f17196 100644
--- a/src/dxmt/dxmt_buffer.hpp
+++ b/src/dxmt/dxmt_buffer.hpp
@@ -39,7 +39,6 @@ enum class BufferAllocationFlag : uint32_t {
   GpuManaged = 4,
   /* will allocate at least one page of memory and try to suballocate from that */
   SuballocateFromOnePage = 5,
-  CpuPlaced = 6,
 };
 
 struct BufferViewKey {
@@ -162,8 +161,6 @@ private:
   uint32_t current_suballocation_ = 0;
   uint32_t suballocation_size_;
   uint32_t suballocation_count_ = 1;
-
-  void * placed_buffer = nullptr;
 };
 
 class Buffer {
@@ -223,4 +220,4 @@ struct BufferSlice {
   uint32_t elementCount = 0;
 };
 
-} // namespace dxmt
\ No newline at end of file
+} // namespace dxmt
diff --git a/src/dxmt/dxmt_context.cpp b/src/dxmt/dxmt_context.cpp
index c8cd06d..eba284f 100644
--- a/src/dxmt/dxmt_context.cpp
+++ b/src/dxmt/dxmt_context.cpp
@@ -55,9 +55,14 @@ ArgumentEncodingContext::ArgumentEncodingContext(CommandQueue &queue, WMT::Devic
   dummy_sampler_info_.max_anisotroy = 1;
   dummy_sampler_info_.lod_average = false;
   dummy_sampler_ = device.newSamplerState(dummy_sampler_info_);
-  dummy_cbuffer_host_ = wsi::aligned_malloc(65536, DXMT_PAGE_SIZE);
   dummy_cbuffer_info_.length = 65536;
+#ifdef __i386__
+  // The native Winemetal owner publishes mapped storage that remains valid with dummy_cbuffer_.
+  dummy_cbuffer_info_.memory.set(nullptr);
+#else
+  dummy_cbuffer_host_ = wsi::aligned_malloc(65536, DXMT_PAGE_SIZE);
   dummy_cbuffer_info_.memory.set(dummy_cbuffer_host_);
+#endif
   dummy_cbuffer_info_.options = WMTResourceOptionCPUCacheModeWriteCombined | WMTResourceStorageModeShared |
                                 WMTResourceHazardTrackingModeUntracked;
   dummy_cbuffer_ = device.newBuffer(dummy_cbuffer_info_);
@@ -70,7 +75,9 @@ ArgumentEncodingContext::ArgumentEncodingContext(CommandQueue &queue, WMT::Devic
 };
 
 ArgumentEncodingContext::~ArgumentEncodingContext() {
+#ifndef __i386__
   wsi::aligned_free(dummy_cbuffer_host_);
+#endif
 };
 
 template void ArgumentEncodingContext::encodeVertexBuffers<PipelineKind::Ordinary>(uint32_t slot_mask, uint64_t argument_buffer_offset);
@@ -1685,4 +1692,4 @@ SimpleCommandContext<ArgumentEncodingContext>::setComputeBytes(uint32_t index, u
   return temp;
 }
 
-} // namespace dxmt
\ No newline at end of file
+} // namespace dxmt
diff --git a/src/dxmt/dxmt_occlusion_query.hpp b/src/dxmt/dxmt_occlusion_query.hpp
index 56e9e76..427ad08 100644
--- a/src/dxmt/dxmt_occlusion_query.hpp
+++ b/src/dxmt/dxmt_occlusion_query.hpp
@@ -2,7 +2,6 @@
 
 #include "Metal.hpp"
 #include "rc/util_rc_ptr.hpp"
-#include "wsi_platform.hpp"
 #include <atomic>
 #include <cassert>
 #include <cstdint>
@@ -166,9 +165,6 @@ public:
       queries(queries) {
         visibility_result_heap_info.options = WMTResourceHazardTrackingModeUntracked;
         visibility_result_heap_info.memory.set(nullptr);
-#ifdef __i386__
-        visibility_result_heap_info.memory.set(wsi::aligned_malloc(num_results * sizeof(uint64_t), DXMT_PAGE_SIZE));
-#endif
         visibility_result_heap_info.length = num_results * sizeof(uint64_t);
         visibility_result_heap = device.newBuffer(visibility_result_heap_info);
       }
@@ -176,9 +172,6 @@ public:
     for (auto query : queries) {
       query->issue(seq_id, (uint64_t *)visibility_result_heap_info.memory.get(), num_results);
     }
-#ifdef __i386__
-    wsi::aligned_free(visibility_result_heap_info.memory.get());
-#endif
   }
 
   VisibilityResultReadback(const VisibilityResultReadback &) = delete;
@@ -187,6 +180,7 @@ public:
   uint64_t seq_id;
   uint64_t num_results;
   std::vector<Rc<VisibilityResultQuery>> queries;
+  // memory is borrowed from visibility_result_heap.
   WMTBufferInfo visibility_result_heap_info;
   WMT::Reference<WMT::Buffer> visibility_result_heap;
 };
diff --git a/src/dxmt/dxmt_ring_bump_allocator.hpp b/src/dxmt/dxmt_ring_bump_allocator.hpp
index 5c92d92..1dde890 100644
--- a/src/dxmt/dxmt_ring_bump_allocator.hpp
+++ b/src/dxmt/dxmt_ring_bump_allocator.hpp
@@ -96,10 +96,12 @@ public:
     void *mapped_address;
 
     ~Block() {
+#ifndef __i386__
       if (mapped_address) {
         free(mapped_address);
         mapped_address = nullptr;
       }
+#endif
     };
 
     Block() = default;
@@ -116,12 +118,20 @@ public:
   Block
   allocate(size_t block_size) {
     Block block{};
+    block.mapped_address = nullptr;
+#ifndef __i386__
     block.mapped_address = placed_buffer_ ? malloc(block_size) : nullptr;
+#endif
     WMTBufferInfo info;
     info.options = buffer_info_;
     info.memory.set(block.mapped_address);
     info.length = block_size;
     block.buffer = device_.newBuffer(info);
+#ifdef __i386__
+    // Mapped storage is borrowed from block.buffer when a placed buffer was requested.
+    if (placed_buffer_)
+      block.mapped_address = info.memory.get_accessible_or_null();
+#endif
     block.gpu_address = info.gpu_address;
     return block;
   };
@@ -238,4 +248,4 @@ RingBumpState<Allocator, BlockSize, mutex>::allocate_or_reuse_block(
   return fifo.back();
 };
 
-} // namespace dxmt
\ No newline at end of file
+} // namespace dxmt
diff --git a/src/dxmt/dxmt_staging.cpp b/src/dxmt/dxmt_staging.cpp
index 80a3d62..0353bbf 100644
--- a/src/dxmt/dxmt_staging.cpp
+++ b/src/dxmt/dxmt_staging.cpp
@@ -77,9 +77,6 @@ StagingResource::allocate(uint64_t coherent_seq_id) {
   }
   if (ret == ~0ull) {
     Flags<BufferAllocationFlag> flags;
-#ifdef __i386__
-    flags.set(BufferAllocationFlag::CpuPlaced);
-#endif
     buffer_pool.push_back(buffer_->allocate(flags));
     ret = buffer_pool.size() - 1;
   }
diff --git a/src/dxmt/dxmt_texture.cpp b/src/dxmt/dxmt_texture.cpp
index 8db2874..0d09a07 100644
--- a/src/dxmt/dxmt_texture.cpp
+++ b/src/dxmt/dxmt_texture.cpp
@@ -18,7 +18,6 @@
 
 #include "dxmt_texture.hpp"
 #include "dxmt_residency.hpp"
-#include "wsi_platform.hpp"
 #include <atomic>
 #include <cassert>
 
@@ -90,9 +89,6 @@ TextureAllocation::TextureAllocation(
 
 void
 TextureAllocation::free(){
-#ifdef __i386__
-  wsi::aligned_free(mappedMemory);
-#endif
   delete this;
 };
 
@@ -193,9 +189,6 @@ Texture::allocate(Flags<TextureAllocationFlag> flags) {
     buffer_info.length = bytes_per_image_;
     buffer_info.options = options;
     buffer_info.memory.set(nullptr);
-#ifdef __i386__
-    buffer_info.memory.set(wsi::aligned_malloc(bytes_per_image_, DXMT_PAGE_SIZE));
-#endif
     auto buffer = device_.newBuffer(buffer_info);
     return new TextureAllocation(this, std::move(buffer), buffer_info.memory.get(), info, bytes_per_row_, flags);
   }
@@ -349,4 +342,4 @@ RenamableTexturePool::getNext(uint64_t frame) {
   return allocations_[current_index];
 }
 
-} // namespace dxmt
\ No newline at end of file
+} // namespace dxmt
diff --git a/src/dxmt/dxmt_texture.hpp b/src/dxmt/dxmt_texture.hpp
index 68d43cd..9defce8 100644
--- a/src/dxmt/dxmt_texture.hpp
+++ b/src/dxmt/dxmt_texture.hpp
@@ -145,6 +145,7 @@ public:
   }
 
   Texture *descriptor;
+  // Borrowed from buffer_ for buffer-backed textures.
   void *mappedMemory;
   uint64_t gpuResourceID;
   mach_port_t machPort;
@@ -323,4 +324,4 @@ private:
   std::atomic<uint32_t> refcount_ = {0u};
 };
 
-} // namespace dxmt
\ No newline at end of file
+} // namespace dxmt
