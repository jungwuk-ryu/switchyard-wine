index 68d43cd..161a881 100644
--- a/src/dxmt/dxmt_texture.hpp
+++ b/src/dxmt/dxmt_texture.hpp
@@ -38,6 +38,8 @@ enum class TextureAllocationFlag : uint32_t {
   GpuManaged = 4,
   Shared = 5,
   ShaderReadonly = 6,
+  /* caller owns guest-addressable storage wrapped by the Metal buffer */
+  CpuPlaced = 7,
 };
 
 struct TextureViewDescriptor {
@@ -145,6 +147,7 @@ public:
   }
 
   Texture *descriptor;
+  // Borrowed from buffer_ for buffer-backed textures.
   void *mappedMemory;
   uint64_t gpuResourceID;
   mach_port_t machPort;
@@ -170,6 +173,9 @@ private:
   uint32_t version_ = 0;
   Flags<TextureAllocationFlag> flags_;
   small_vector<TextureViewRef, 4> cached_view_;
+#if defined(__arm64ec__) || defined(_M_ARM64EC)
+  void *owned_mapped_buffer_ = nullptr;
+#endif
 };
 
 class Texture {
@@ -323,4 +329,4 @@ private:
   std::atomic<uint32_t> refcount_ = {0u};
 };
 
-} // namespace dxmt
\ No newline at end of file
+} // namespace dxmt
